---
title: pwnspirit
layout: layout.njk
pagination:
  data: collections.posts
  size: 5
  alias: posts
permalink: "{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% else %}index.html{% endif %}"
---
<ul class="post-list">
  {% for post in posts %}
  <li class="post-item">
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <span class="post-date">{{ post.date | postDate }}</span>
  </li>
  {% endfor %}
</ul>

<div class="pagination">
  {% if pagination.href.previous %}
    <a href="{{ pagination.href.previous }}">&larr; Newer</a>
  {% else %}
    <span></span>
  {% endif %}
  <span>Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
  {% if pagination.href.next %}
    <a href="{{ pagination.href.next }}">Older &rarr;</a>
  {% else %}
    <span></span>
  {% endif %}
</div>
